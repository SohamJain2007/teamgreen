# Admin password for /admin, at least 12 characters. Admin is disabled without it (no default).
# Generate: openssl rand -base64 18
ADMIN_PASSWORD=

# Salt used to hash IPs for rate limiting / one-vote-per-person. Set to any long random string.
IP_HASH_SALT=change-me-too

# Where photos are stored (STORAGE_DRIVER=local). Point at a persistent disk in production.
UPLOAD_DIR=./uploads
STORAGE_DRIVER=local

# SQLite file location. Point at a persistent disk in production.
DATABASE_PATH=./data/safai.db

# Public base URL (used for share/OG links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Sending complaints to officials ----------
# off (default): nothing is sent | dry-run: deliveries are logged to the console and admin, nothing is sent | live: really send
NOTIFY_MODE=off
# Confirmations from people nearby (other than the reporter) before a report is Verified and sent. Default 3.
VERIFY_CONFIRMATIONS=3
# WhatsApp only goes to councillors whose ward has "verified": true in data/wards.json, unless this is true.
NOTIFY_UNVERIFIED_CONTACTS=false

# Email to RMC (any SMTP provider: Gmail app password, Zoho, Brevo, Amazon SES, ...)
RMC_EMAIL=support@ranchimunicipal.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SafaiRanchi <complaints@your-domain.in>"
MAIL_REPLY_TO=

# WhatsApp to ward councillors (Meta WhatsApp Cloud API, see README "Going live")
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=garbage_complaint
WHATSAPP_TEMPLATE_LANG=en
