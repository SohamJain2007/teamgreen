# Admin password for /admin, at least 12 characters. Admin is disabled without it (no default).
# Generate: openssl rand -base64 18
ADMIN_PASSWORD=

# Salt used to hash IPs for rate limiting / one-vote-per-person. Set to any long random string.
IP_HASH_SALT=change-me-too

# Where photos are stored (STORAGE_DRIVER=local). Point at a persistent disk in production.
UPLOAD_DIR=./uploads
STORAGE_DRIVER=local

# SQLite file location. Point at a persistent disk in production (the Docker image defaults to /data/safai.db).
DATABASE_PATH=./data/safai.db
# Daily database snapshots (production server only; newest 7 kept). Default: a "backups" folder next to the database.
BACKUP_DIR=
# Number of proxies in front of the app that append to X-Forwarded-For (Railway: 1). Used for rate limiting and votes.
TRUSTED_PROXY_HOPS=1

# Public base URL (used for share/OG links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Sending complaints to officials ----------
# off (default): nothing is sent | dry-run: deliveries are logged to the console and admin, nothing is sent | live: really send
NOTIFY_MODE=off
# Confirmations from people nearby (other than the reporter) before a report is Verified and sent. Default 1.
VERIFY_CONFIRMATIONS=1
# Councillors are only contacted when their ward has "verified": true in data/wards.json, unless this is true.
NOTIFY_UNVERIFIED_CONTACTS=false

# Email to RMC (any SMTP provider: Gmail app password, Zoho, Brevo, Amazon SES, ...)
RMC_EMAIL=support@ranchimunicipal.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SafaiRanchi <complaints@your-domain.in>"
MAIL_REPLY_TO=

# ---------- Telling reporters their spot was cleared ----------
# Reporters must give a mobile number or email. When the spot is cleared (by admin or a citizen photo) they get one message.
# off (default) | dry-run (logged only) | live. Independent of NOTIFY_MODE. Email uses the SMTP_* / MAIL_FROM settings above.
REPORTER_NOTIFY_MODE=off
# SMS provider (councillor complaints and reporter notices): twilio or fast2sms
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAST2SMS_API_KEY=
